LEGACY_CULTURE=en-US

# Optional locally. Required in production. Use an explicitly named app-owned database.
# DATABASE_URL=postgresql://alfadata@127.0.0.1:5432/alfadata
# Account routes require all of the following settings. Use HTTPS outside loopback development.
# BETTER_AUTH_URL=http://127.0.0.1:3000
# Supply an independently generated secret of at least 32 characters.
# BETTER_AUTH_SECRET=
# SMTP_URL=smtps://smtp.example.invalid:465
# SMTP_FROM=Alfadata <mail@example.invalid>

# Trial settings. See docs/TRIAL-RECOVERY.md before provisioning or restoring.
# TRIAL_REGISTRY_NAMESPACE=
# TRIAL_IDENTITY_KEY_REF=
# TRIAL_IDENTITY_KEY_HEX=
# TRIAL_MIRROR_EPOCH=
# TRIAL_REGISTRY_URL=
# TRIAL_REGISTRY_TOKEN=
# Development only. Store outside the PostgreSQL data directory.
# TRIAL_LOCAL_REGISTRY_FILE=

# Optional. Set only for an ingress that strips and replaces both geo headers.
# ALFADATA_GEO_EDGE_TOKEN=

# Commerce stays closed until the approved English purchase policy and provider are configured.
# CHECKOUT_PROVIDER_ID=
# Development only. Use CHECKOUT_PROVIDER_ID=test with a synthetic policy.
# TEST_PAYMENT_SECRET=
# PURCHASE_POLICY_VERSION=
# PURCHASE_POLICY_TEXT=
# COMPANY_WHATSAPP_NUMBER=966563447314
# Set only after approving the published retention policy and production processor.
# DELETION_BUSINESS_CALENDAR is JSON with timeZone, sorted businessDates and policyText.
# Set to yes only after approving handling of open orders and late settlements.
# CLOSURE_OPERATIONS_APPROVED=
